#!/usr/bin/env bash
# Sets session indicators for the tmux session chooser:
#   @claude_busy / @claude_idle — from /tmp/claude-tmux-<pane_num> status files
#   @claude_shell — Claude has a live Bash-tool shell child (catches background
#     commands still running even when the status file says idle)
#   @dev_server — detects server processes running in session panes
#
# The chooser blocks on this script, so it takes one snapshot each of the
# process table, the status files and the panes, works everything out in a
# single awk pass, and applies the result with one tmux invocation — spawning
# processes per session/pane made the chooser visibly laggy.

today_start=$(date -j -f '%Y-%m-%d %H:%M:%S' "$(date +%Y-%m-%d) 00:00:00" +%s)
now=$(date +%s)
active_decay_seconds=$((5 * 3600))

{
  ps -axo pid=,ppid=,tty=,ucomm=,args=
  echo '@@'
  stat -f '%m %N' /tmp/claude-tmux-* 2>/dev/null
  echo '@@'
  tmux list-panes -a -F '#{session_id}	#{pane_id}	#{pane_pid}	#{pane_tty}	#{pane_current_command}	#{@last_attached}'
} | awk -v today_start="$today_start" -v now="$now" -v decay="$active_decay_seconds" '
  $0 == "@@" { part++; if (part == 2) FS = "\t"; next }

  # Process table
  part == 0 {
    kids[$2] = kids[$2] " " $1
    ucomm[$1] = $4
    # Dev server detection via processes on the pane tty
    if ($0 ~ /(puma|rails[[:space:]]s|foreman[[:space:]]start|overmind[[:space:]]start|next[[:space:]]dev|vite|webpack.*dev-server|bin\/dev)/)
      dev_tty[$3] = 1
    next
  }

  # Status file mtimes
  part == 1 { mtime[$2] = $1; next }

  # Panes
  {
    session = $1; pane_id = $2; pane_pid = $3; pane_tty = $4; cmd = $5
    if (!(session in seen)) {
      seen[session] = 1
      sessions[++count] = session
      if ($6 != "" && now - $6 > decay) expired[session] = 1
    }

    # Claude Code detection (version number as command name)
    if (cmd ~ /^[0-9]+\.[0-9]+\.[0-9]+$/) {
      if (!(session in claude)) {
        status_file = "/tmp/claude-tmux-" substr(pane_id, 2)
        if (status_file in mtime) {
          status = ""
          getline status < status_file
          close(status_file)
          if (status == "busy")
            claude[session] = "busy"
          else if (status == "idle" && mtime[status_file] >= today_start)
            claude[session] = "idle"
        }
      }

      # Bash-tool shell detection: claude runs commands as zsh/bash children
      if (!(session in shell)) {
        n = split(kids[pane_pid], children, " ")
        for (i = 1; i <= n && !(session in shell); i++) {
          m = split(kids[children[i]], grandchildren, " ")
          for (j = 1; j <= m; j++)
            if (ucomm[grandchildren[j]] ~ /^(zsh|bash)$/) { shell[session] = 1; break }
        }
      }
    }

    tty_short = pane_tty
    sub("^/dev/", "", tty_short)
    if (tty_short in dev_tty) dev[session] = 1
  }

  function set(session, option, on) {
    printf "set-option -q%st \047%s\047 %s%s\n", (on ? "" : "u"), session, option, (on ? " 1" : "")
  }

  END {
    for (k = 1; k <= count; k++) {
      session = sessions[k]
      if (session in expired) set(session, "@active", 0)
      set(session, "@claude_busy", claude[session] == "busy")
      set(session, "@claude_idle", claude[session] == "idle")
      set(session, "@claude_shell", session in shell)
      set(session, "@dev_server", session in dev)
    }
  }
' | tmux source-file -
